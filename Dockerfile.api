# Backend инференса. Контекст сборки - каталог service/: он самодостаточен
# (код модели в reid/, конфиги в configs/, веса в weights/).
FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime

WORKDIR /service
ENV PYTHONUNBUFFERED=1 \
    SERVICE_DIR=/service \
    TORCH_CACHE=/service/pretrained_cache

RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt

COPY reid ./reid
COPY configs ./configs
COPY api ./api
# веса ансамбля: инференс ничего не качает из сети
COPY weights ./weights

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "120"]
